{
  "manifest_version": 3,
  "name": "My first extension",
  "version": "1.0",
  "description": "The smallest extension Chrome will load",
  "permissions":[
    "storage"
  ],
  "action": {
    "default_popup":"popup.html",
    "default_title": "Click Me"
  },
  "options_page":"options.html",
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
 
  ],
  "background":{
    "service_worker":"background.js"
  }
}